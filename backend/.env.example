# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# Required: Cerebras API key (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# Required: GitHub personal access token with repo read scope
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Directory where repos are cloned (created automatically)
REPO_CACHE_DIR=/tmp/gitone_repos

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Investigation loop limits
MAX_ITERATIONS=6
MAX_REFINE_ITERATIONS=2
